# All settings are optional; defaults are shown. See app/config.py.

# HuggingFace token, only needed for gated models (e.g. LLM_PRESET=llama3)
# HF_TOKEN=hf_your-token-here

# Embedding model preset: fast | balanced | medical | medical-alt
# EMBEDDING_PRESET=fast

# LLM preset: phi3 | mistral | llama3 | gemma
# LLM_PRESET=phi3
# LLM backend: auto (MLX on Apple Silicon if mlx-lm is installed, else torch) | mlx | torch
# LLM_BACKEND=auto
# 4-bit quantization for the torch backend on CUDA (MLX presets are already 4-bit)
# LOAD_IN_4BIT=false

# Vector store
# VECTOR_STORE_PATH=data/vector_store
# COLLECTION_NAME=patient_docs

# Chunking (tokens)
# CHUNK_SIZE=300
# CHUNK_OVERLAP=50

# Readability target (US grade level)
# TARGET_GRADE_LEVEL=8
