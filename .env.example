# All settings are optional; defaults are shown. See app/config.py.

# HuggingFace token, only needed for gated models (e.g. LLM_PRESET=llama3)
# HF_TOKEN=hf_your-token-here

# Embedding model preset: fast | balanced | medical | medical-alt
# EMBEDDING_PRESET=fast
# auto (ONNX for "fast", no PyTorch needed) | onnx | sentence-transformers
# EMBEDDING_BACKEND=auto
# Where the ONNX embedding model is downloaded (default ~/.cache/chroma)
# MODEL_CACHE_DIR=.models

# Set false to turn AI simplification off; /simplify and simplified /ask then return 503
# ENABLE_LLM=true

# LLM provider: auto (Gemini if GEMINI_API_KEY is set, local model as fallback
# when installed; else the local model) | gemini | local (nothing leaves the machine)
# LLM_PROVIDER=auto
# Get a key at https://aistudio.google.com/apikey. On the free tier Google may
# use prompts to improve its products; use sample or de-identified documents.
# GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TIMEOUT=30
# Use the local model when Gemini times out, is rate limited or down
# LLM_FALLBACK=true
# Limits on LLM requests (0 = none): per client per minute, all clients per day
# LLM_REQUESTS_PER_MINUTE=10
# LLM_REQUESTS_PER_DAY=500
# MAX_INPUT_CHARS=20000
# Replace patient identifiers with placeholders before text reaches the LLM
# (restored in the answer). Rule-based; see app/privacy/deid.py for its limits.
# DEIDENTIFY=true

# LLM preset: phi3 | mistral | llama3 | gemma
# LLM_PRESET=phi3
# LLM backend: auto (MLX on Apple Silicon if mlx-lm is installed, else torch) | mlx | torch
# LLM_BACKEND=auto
# 4-bit quantization for the torch backend on CUDA (MLX presets are already 4-bit)
# LOAD_IN_4BIT=false

# Vector store
# VECTOR_STORE_PATH=data/vector_store
# COLLECTION_NAME=patient_docs

# Chunking (tokens)
# CHUNK_SIZE=300
# CHUNK_OVERLAP=50

# Readability target (US grade level)
# TARGET_GRADE_LEVEL=8
